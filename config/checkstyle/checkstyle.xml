<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    ShinColle-kai checkstyle ruleset.

    Goal: catch real mistakes (unused imports, tabs, missing trailing
    newline, overlong lines) without forcing a large one-time rewrite of
    the existing codebase. Rules that would currently flag a large,
    pre-existing, stylistic-only pattern (star imports) are kept at
    "warning" severity so they show up in the report without failing
    the build - clean them up gradually rather than in one commit.

    See AGENTS.md "Coding Style & Naming Conventions" for the prose
    version of these rules.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- every file must end with a newline -->
    <module name="NewlineAtEndOfFile"/>

    <!-- tabs are not used anywhere in this repo; 4-space indent only -->
    <module name="FileTabCharacter"/>

    <!-- generous line-length ceiling: this repo has long lambda chains
         and Forge config comments; the point is catching truly unwieldy
         lines, not enforcing an 80/100-column style -->
    <module name="LineLength">
        <property name="max" value="150"/>
        <property name="ignorePattern" value="^import .*$"/>
    </module>

    <module name="TreeWalker">
        <!-- catches real dead weight left behind by refactors -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- star imports are common in this codebase already (~47 files);
             flagged for future cleanup but not build-blocking -->
        <module name="AvoidStarImport">
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
